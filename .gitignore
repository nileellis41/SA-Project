# Raw and processed data never go into git (Bloomberg data is licensed)
data/raw/*
data/processed/*
signals/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!signals/.gitkeep
*.csv
*.parquet
*.xlsx

# Derived result tables cited by the reports are small and safe to publish
!reports/tables/*.csv
!reports/tables_27_spreads/*.csv
!reports/tables_before_breadth/*.csv
!results/*/*.csv
!analysis/experiments/*.csv
!analysis/portfolio_diagnostics/tables/*.csv
!submission/tables/*.csv

# Regenerable caches and logs (runs.pkl is over GitHub's 100 MB limit)
*.pkl
*.log

# Drafts, archives and duplicates
*.zip
*_prepatch.pptx
SA Draft Presentation.pptx
Sleeve 1 PCA Curve Residuals.pptx
final_presentation/

# Third-party paper: cite it, do not redistribute
Optimal Mean Reversion Trading*.pdf

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/
